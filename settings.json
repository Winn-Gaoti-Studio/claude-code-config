{
  "advisorModel": "opus",
  "agentPushNotifEnabled": true,
  "effortLevel": "xhigh",
  "enabledPlugins": {
    "code-review@claude-plugins-official": true,
    "codex@openai-codex": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "slack@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true
  },
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-sonnet-5"
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "repo": "openai/codex-plugin-cc",
        "source": "github"
      }
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.claude/hooks/auto-assign-pr.sh\"",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.claude/hooks/context-compact-reminder.sh\"",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  },
  "inputNeededNotifEnabled": true,
  "model": "claude-opus-4-8[1m]",
  "permissions": {
    "allow": [
      "mcp__tavily",
      "Skill(tavily-best-practices)",
      "Skill(tavily-cli)",
      "Skill(tavily-crawl)",
      "Skill(tavily-dynamic-search)",
      "Skill(tavily-extract)",
      "Skill(tavily-map)",
      "Skill(tavily-research)",
      "Skill(tavily-search)",
      "mcp__pencil"
    ],
    "defaultMode": "auto"
  },
  "statusLine": {
    "command": "bash \"$HOME/.claude/statusline.sh\"",
    "refreshInterval": 30,
    "type": "command"
  },
  "subagentStatusLine": {
    "command": "bash \"$HOME/.claude/subagent-statusline.sh\"",
    "type": "command"
  },
  "tui": "fullscreen",
  "ultracode": true
}
